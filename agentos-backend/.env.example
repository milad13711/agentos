# Copy this file to .env in the project root (agentos-backend/.env) and fill in real values.
# .env is loaded automatically by src/env-loader.js — no extra package needed.

PORT=8787

# Must be a long random string in any shared/production environment.
# If left unset, a random one is generated at boot (fine for solo local dev,
# but it invalidates all sessions every time you restart the server).
AGENTOS_TOKEN_SECRET=change-me-to-a-long-random-string

# AI Gateway — supports Anthropic (Claude) and OpenAI (GPT). Set ONE of these.
# If both are set, ANTHROPIC_API_KEY wins unless you force AI_PROVIDER below.
# Get a real key from https://console.anthropic.com/ to enable the live AI Gateway.
# Without any key, /api/agent/act falls back to a tiny offline DEV_MOCK parser.
ANTHROPIC_API_KEY=
AGENTOS_MODEL=claude-sonnet-4-6

# OpenAI (ChatGPT) alternative — get a key from https://platform.openai.com/api-keys
# OR from an OpenAI-compatible reseller (e.g. GapGPT, common for Iran-based
# access since OpenAI itself blocks Iranian IPs/accounts). If using a
# reseller, also set OPENAI_BASE_URL to THEIR endpoint, not OpenAI's.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# For GapGPT specifically, check your GapGPT dashboard for the exact current
# base URL they assign you — resellers change this occasionally. As of
# writing it's commonly: OPENAI_BASE_URL=https://api.gapgpt.app/v1
# If the reseller rejects the request because of response_format, add:
# OPENAI_JSON_MODE=off

# Optional: force which provider to use (anthropic | openai). If unset, it's
# auto-detected from whichever key above is present.
AI_PROVIDER=

# The first user who registers/logs in with this email becomes Super Admin
# (access to frontend-local/admin.html).
SUPER_ADMIN_EMAIL=you@yourcompany.com

# Real payment gateway (Zarinpal) — get a merchant ID from https://next.zarinpal.com
# Set ZARINPAL_SANDBOX=1 to test with fake payments before your merchant account is approved.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=1
# Must be the real public domain your users load in their browser — Zarinpal
# redirects the user's browser here after payment (e.g. https://exirsms.ir).
PUBLIC_APP_URL=

# Telegram integration — get a token from @BotFather on Telegram (BotFather
# -> /newbot). Leave empty to keep Telegram disabled (server logs it and
# moves on, nothing else changes). Once set, the backend polls Telegram for
# messages (long polling — no public webhook URL needed) and users link
# their account from Settings -> اتصال تلگرام.
TELEGRAM_BOT_TOKEN=

# Only needed if api.telegram.org is filtered from where the server runs
# (confirmed the case for at least one Iran-hosted deployment — even
# querying 8.8.8.8 directly for api.telegram.org returns a hijacked private
# IP, so this isn't a local DNS misconfiguration, it's network-level
# interception). Point this at a SOCKS5 proxy you control (e.g. a
# v2ray/shadowsocks/ssh -D tunnel to a server outside the filtered network)
# and every Telegram API call routes through it instead of connecting
# directly. Leave empty if Telegram is directly reachable.
# TELEGRAM_SOCKS_PROXY=socks5://user:pass@host:port

# Voice conversation (STT + TTS) — used by both the web ChatPanel mic/speaker
# and Telegram voice notes. Deliberately a SEPARATE, real, direct OpenAI key
# from OPENAI_API_KEY above (that one is usually GapGPT, an OpenAI-compatible
# reseller — voice quality depends on genuinely reaching OpenAI's own
# /audio/transcriptions and /audio/speech endpoints, which a text-only
# reseller proxy may not mirror faithfully). Leave empty to keep voice
# disabled entirely (mic button/voice notes just say it's not configured).
OPENAI_VOICE_API_KEY=
# OPENAI_VOICE_BASE_URL=https://api.openai.com/v1
# OPENAI_STT_MODEL=gpt-4o-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# Web Push (browser/PWA) notifications — independent channel from Telegram;
# reminders.js sends through both. Generate a real key pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# and paste both values here (never commit real ones). Leave empty to keep
# push disabled — the mic/notification UI just won't offer it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourcompany.com

# Optional overrides:
# AGENTOS_DB_PATH=./data/agentos.sqlite
# TELEGRAM_API_BASE=https://api.telegram.org   # override only for tests/mocking
