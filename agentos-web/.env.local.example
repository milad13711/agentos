# Copy to .env.local

# URL of the real AgentOS backend (agentos-backend). The Next.js server talks
# to this directly (server-to-server, no CORS issue) — the browser never
# calls it directly and never sees the AgentOS session token.
AGENTOS_API_URL=http://localhost:8787

# Must match in spirit the backend's own secret story — this is independent,
# it's just used to mark the cookie as Secure only outside local dev.
NODE_ENV=development
