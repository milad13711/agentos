# Place this next to docker-compose.yml. docker compose reads it automatically.

# Leave both empty to keep using SQLite (the default — fine for a single
# instance). Only set these once you enable the optional `postgres` service
# in docker-compose.yml — see DEPLOY.md "PostgreSQL migration checklist".
# DATABASE_URL=postgres://agentos:change-me@postgres:5432/agentos
# POSTGRES_PASSWORD=change-me

AGENTOS_TOKEN_SECRET=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=
AGENTOS_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
AI_PROVIDER=
SUPER_ADMIN_EMAIL=you@yourcompany.com
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=1
PUBLIC_APP_URL=http://94.182.93.52
